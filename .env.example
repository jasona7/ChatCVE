# ChatCVE Environment Configuration
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# AI Provider Configuration
# ---------------------------------------------------------------------------
# AI_PROVIDER selects the LLM backend:
#   openai | azure-openai | anthropic | bedrock | gemini | ollama
AI_PROVIDER=openai

# Model override (optional - sensible defaults per provider are built in)
# Examples: gpt-4o | claude-sonnet-4-20250514 | gemini-2.0-flash | llama3.1
LLM_MODEL=

# --- OpenAI (default) ---
OPENAI_API_KEY=sk-your-api-key-here
# Optional custom OpenAI-compatible endpoint (e.g., vLLM, LiteLLM proxy)
OPENAI_BASE_URL=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Google Gemini ---
GOOGLE_API_KEY=

# --- Ollama (local/private models - no API key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# Sampling temperature for the AI analyst (0 = deterministic)
LLM_TEMPERATURE=0

# ---------------------------------------------------------------------------
# Other Configuration
# ---------------------------------------------------------------------------

# NVD API Key (Optional - increases rate limit from 5 to 50 requests/30s)
# Get your key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Flask environment (development/production)
FLASK_ENV=development

# JWT configuration
JWT_SECRET_KEY=chatcve-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24
