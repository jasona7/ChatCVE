# ChatCVE Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (Required for AI chat features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# NVD API Key (Optional - increases rate limit from 5 to 50 requests/30s)
# Get your key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Flask environment (development/production)
FLASK_ENV=development
